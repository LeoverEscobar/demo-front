# Base path the axios client hits. In dev, keep it relative so the Vite proxy handles it.
# In prod, set to the full absolute URL of the API (e.g. https://api.example.com/api/v1).
VITE_API_BASE_URL=/api/v1

# Upstream Symfony API used by the Vite dev proxy (only read at dev server startup).
# Change this if your local Symfony runs on a different host/port.
#
# Nota: usa 127.0.0.1 en lugar de localhost en Windows. Node resuelve
# localhost a ::1 (IPv6) primero, y si Symfony escucha solo en IPv4 el
# proxy se cuelga esperando timeout.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
